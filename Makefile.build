PHONY := __build
__build:


obj-y :=
subdir-y :=
EXTRA_CFLAGS :=
EXTRA_LDFLAGS :=
include Makefile

# obj-y := a.o b.o c/ d/
# $(filter %/, $(obj-y))   : c/ d/
# __subdir-y  : c d
# subdir-y    : c d
__subdir-y	:= $(patsubst %/,%,$(filter %/, $(obj-y)))
subdir-y	+= $(__subdir-y)

# c/built-in.o d/built-in.o
subdir_objs := $(foreach f,$(subdir-y),$(f)/built-in.o)

# a.o b.o
cur_objs := $(filter-out %/, $(obj-y))
dep_files := $(foreach f,$(cur_objs),.$(f).d)
dep_files := $(wildcard $(dep_files))

ifneq ($(dep_files),)
  include $(dep_files)
endif


# Old objects without dependency files must be rebuilt once to learn headers.
missing_dep_objs := $(foreach o,$(cur_objs),$(if $(wildcard .$(o).d),,$(o)))
ifneq ($(strip $(missing_dep_objs)),)
$(missing_dep_objs): FORCE_DEPENDENCIES
endif
PHONY += FORCE_DEPENDENCIES
FORCE_DEPENDENCIES:

PHONY += $(subdir-y)


__build : $(subdir-y) built-in.o

$(subdir-y):
	make -C $@ -f $(TOPDIR)/Makefile.build

built-in.o : $(cur_objs) $(subdir_objs)
	$(LD) -r -o $@ $^ -melf_i386 $(EXTRA_LDFLAGS)


%.o : %.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $(CFLAGS_$@) -MMD -MP -MF .$@.d -MT $@ -c -o $@ $<

%.o : %.c
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $(CFLAGS_$@) -MMD -MP -MF .$@.d -MT $@ -c -o $@ $<


	
.PHONY : $(PHONY)